0443],[3.05,0.00381],[3.1,0.00327],[3.15,0.00279],[3.2,0.00238],[3.25,0.00203],[3.3,0.00172],[3.35,0.00146],[3.4,0.00123],[3.45,0.00104],[3.5,0.00087],[3.55,0.00073],[3.6,0.00061],[3.65,0.00051],[3.7,0.00042],[3.75,0.00035],[3.8,0.00029],[3.85,0.00024],[3.9,0.0002],[3.95,0.00016],[4,0.00013]]}],"shade":{"from":1.5,"to":4,"label":"0.0668"},"vlines":[{"x":1.5,"label":"z = 1.5"}],"xLabel":"z","yLabel":"density"}}]}],"Basic Sorting (Selection/Bubble/Insertion)":[{"title":"Bubble sort on [5, 1, 4, 2, 8]","intro":"Watch how each pass pushes the largest number to the right.","frames":[{"caption":"We start with the list **[5, 1, 4, 2, 8]**. Bubble sort walks left to right, **compares neighbours**, and swaps them if the left one is bigger. After each full pass, the biggest remaining number has 'bubbled' to the end.","diagram":{"kind":"array","values":[5,1,4,2,8]}},{"caption":"Pass 1: compare **5** and **1**. Since 5 > 1, they are in the wrong order, so we **swap**.","diagram":{"kind":"array","values":[5,1,4,2,8],"states":{"0":"compare","1":"compare"},"pointers":{"j":0,"j+1":1}}},{"caption":"After the swap: **[1, 5, 4, 2, 8]**.","diagram":{"kind":"array","values":[1,5,4,2,8],"states":{"0":"swap","1":"swap"}}},{"caption":"Pass 1: compare **5** and **4**. Since 5 > 4, they are in the wrong order, so we **swap**.","diagram":{"kind":"array","values":[1,5,4,2,8],"states":{"1":"compare","2":"compare"},"pointers":{"j":1,"j+1":2}}},{"caption":"After the swap: **[1, 4, 5, 2, 8]**.","diagram":{"kind":"array","values":[1,4,5,2,8],"states":{"1":"swap","2":"swap"}}},{"caption":"Pass 1: compare **5** and **2**. Since 5 > 2, they are in the wrong order, so we **swap**.","diagram":{"kind":"array","values":[1,4,5,2,8],"states":{"2":"compare","3":"compare"},"pointers":{"j":2,"j+1":3}}},{"caption":"After the swap: **[1, 4, 2, 5, 8]**.","diagram":{"kind":"array","values":[1,4,2,5,8],"states":{"2":"swap","3":"swap"}}},{"caption":"Pass 1: compare **5** and **8**. 5 ≤ 8, already in order. **No swap.**","diagram":{"kind":"array","values":[1,4,2,5,8],"states":{"3":"compare","4":"compare"},"pointers":{"j":3,"j+1":4}}},{"caption":"**End of pass 1.** The largest unsorted number, **8**, is now in its final place (green).","diagram":{"kind":"array","values":[1,4,2,5,8],"states":{"4":"sorted"}}},{"caption":"Pass 2: compare **1** and **4**. 1 ≤ 4, already in order. **No swap.**","diagram":{"kind":"array","values":[1,4,2,5,8],"states":{"0":"compare","1":"compare","4":"sorted"},"pointers":{"j":0,"j+1":1}}},{"caption":"Pass 2: compare **4** and **2**. Since 4 > 2, they are in the wrong order, so we **swap**.","diagram":{"kind":"array","values":[1,4,2,5,8],"states":{"1":"compare","2":"compare","4":"sorted"},"pointers":{"j":1,"j+1":2}}},{"caption":"After the swap: **[1, 2, 4, 5, 8]**.","diagram":{"kind":"array","values":[1,2,4,5,8],"states":{"1":"swap","2":"swap","4":"sorted"}}},{"caption":"Pass 2: compare **4** and **5**. 4 ≤ 5, already in order. **No swap.**","diagram":{"kind":"array","values":[1,2,4,5,8],"states":{"2":"compare","3":"compare","4":"sorted"},"pointers":{"j":2,"j+1":3}}},{"caption":"**End of pass 2.** The largest unsorted number, **5**, is now in its final place (green).","diagram":{"kind":"array","values":[1,2,4,5,8],"states":{"3":"sorted","4":"sorted"}}},{"caption":"Pass 3: compare **1** and **2**. 1 ≤ 2, already in order. **No swap.**","diagram":{"kind":"array","values":[1,2,4,5,8],"states":{"0":"compare","1":"compare","3":"sorted","4":"sorted"},"pointers":{"j":0,"j+1":1}}},{"caption":"Pass 3: compare **2** and **4**. 2 ≤ 4, already in order. **No swap.**","diagram":{"kind":"array","values":[1,2,4,5,8],"states":{"1":"compare","2":"compare","3":"sorted","4":"sorted"},"pointers":{"j":1,"j+1":2}}},{"caption":"**End of pass 3.** The largest unsorted number, **4**, is now in its final place (green). No swaps happened in this pass, so the list is already sorted and we can stop early.","diagram":{"kind":"array","values":[1,2,4,5,8],"states":{"2":"sorted","3":"sorted","4":"sorted"}}},{"caption":"**Sorted:** [1, 2, 4, 5, 8]. \n\n> **Remember:** a list of $n$ items needs at most $n-1$ passes. In the worst case that is $\\frac{n(n-1)}{2}$ comparisons, so bubble sort is $O(n^2)$.","diagram":{"kind":"array","values":[1,2,4,5,8],"states":{"0":"sorted","1":"sorted","2":"sorted","3":"sorted","4":"sorted"}}}]}],"Graph Traversals (BFS/DFS)":[{"title":"BFS from A (queue)","frames":[{"caption":"**Breadth-first search (BFS)** from **A**. BFS uses a **queue** (first in, first out). It visits nodes in 'rings': first everything 1 step away, then 2 steps, and so on.\n\nQueue: **[A]**","diagram":{"kind":"graph","nodes":[{"id":"A","x":10,"y":50,"note":"d=0"},{"id":"B","x":35,"y":15},{"id":"C","x":35,"y":85},{"id":"D","x":62,"y":15},{"id":"E","x":62,"y":85},{"id":"F","x":90,"y":50}],"edges":[{"from":"A","to":"B"},{"from":"A","to":"C"},{"from":"B","to":"D"},{"from":"C","to":"D"},{"from":"C","to":"E"},{"from":"D","to":"F"},{"from":"E","to":"F"}],"nodeStates":{"A":"frontier"},"edgeStates":[]}},{"caption":"Take **A** from the front of the queue and visit it. Its unseen neighbours **B, C** go to the back of the queue (distance 1).\n\nVisited order: **A**  ·  Queue: **[B, C]**","diagram":{"kind":"graph","nodes":[{"id":"A","x":10,"y":50,"note":"d=0"},{"id":"B","x":35,"y":15,"note":"d=1"},{"id":"C","x":35,"y":85,"note":"d=1"},{"id":"D","x":62,"y":15},{"id":"E","x":62,"y":85},{"id":"F","x":90,"y":50}],"edges":[{"from":"A","to":"B"},{"from":"A","to":"C"},{"from":"B","to":"D"},{"from":"C","to":"D"},{"from":"C","to":"E"},{"from":"D","to":"F"},{"from":"E","to":"F"}],"nodeStates":{"B":"frontier","C":"frontier","A":"current"},"edgeStates":[{"from":"A","to":"B","state":"tree"},{"from":"A","to":"C","state":"tree"}]}},{"caption":"Take **B** from the front of the queue and visit it. Its unseen neighbours **D** go to the back of the queue (distance 2).\n\nVisited order: **A → B**  ·  Queue: **[C, D]**","diagram":{"kind":"graph","nodes":[{"id":"A","x":10,"y":50,"note":"d=0"},{"id":"B","x":35,"y":15,"note":"d=1"},{"id":"C","x":35,"y":85,"note":"d=1"},{"id":"D","x":62,"y":15,"note":"d=2"},{"id":"E","x":62,"y":85},{"id":"F","x":90,"y":50}],"edges":[{"from":"A","to":"B"},{"from":"A","to":"C"},{"from":"B","to":"D"},{"from":"C","to":"D"},{"from":"C","to":"E"},{"from":"D","to":"F"},{"from":"E","to":"F"}],"nodeStates":{"B":"current","D":"frontier","C":"frontier","A":"visited"},"edgeStates":[{"from":"A","to":"B","state":"tree"},{"from":"A","to":"C","state":"tree"},{"from":"B","to":"D","state":"tree"}]}},{"caption":"Take **C** from the front of the queue and visit it. Its unseen neighbours **E** go to the back of the queue (distance 2).\n\nVisited order: **A → B → C**  ·  Queue: **[D, E]**","diagram":{"kind":"graph","nodes":[{"id":"A","x":10,"y":50,"note":"d=0"},{"id":"B","x":35,"y":15,"note":"d=1"},{"id":"C","x":35,"y":85,"note":"d=1"},{"id":"D","x":62,"y":15,"note":"d=2"},{"id":"E","x":62,"y":85,"note":"d=2"},{"id":"F","x":90,"y":50}],"edges":[{"from":"A","to":"B"},{"from":"A","to":"C"},{"from":"B","to":"D"},{"from":"C","to":"D"},{"from":"C","to":"E"},{"from":"D","to":"F"},{"from":"E","to":"F"}],"nodeStates":{"D":"frontier","C":"current","A":"visited","E":"frontier","B":"visited"},"edgeStates":[{"from":"A","to":"B","state":"tree"},{"from":"A","to":"C","state":"tree"},{"from":"B","to":"D","state":"tree"},{"from":"C","to":"E","state":"tree"}]}},{"caption":"Take **D** from the front of the queue and visit it. Its unseen neighbours **F** go to the back of the queue (distance 3).\n\nVisited order: **A → B → C → D**  ·  Queue: **[E, F]**","diagram":{"kind":"graph","nodes":[{"id":"A","x":10,"y":50,"note":"d=0"},{"id":"B","x":35,"y":15,"note":"d=1"},{"id":"C","x":35,"y":85,"note":"d=1"},{"id":"D","x":62,"y":15,"note":"d=2"},{"id":"E","x":62,"y":85,"note":"d=2"},{"id":"F","x":90,"y":50,"note":"d=3"}],"edges":[{"from":"A","to":"B"},{"from":"A","to":"C"},{"from":"B","to":"D"},{"from":"C","to":"D"},{"from":"C","to":"E"},{"from":"D","to":"F"},{